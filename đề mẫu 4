----Tìm key có giá trị lớn nhất trong HashMap

import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int N = sc.nextInt();

        HashMap<String, Integer> map = new HashMap<>();

        for (int i = 0; i < N; i++) {
            String key = sc.next();
            int value = sc.nextInt();

            map.put(key, value);
        }

        String bestKey = "";
        int bestValue = Integer.MIN_VALUE;

        for (Map.Entry<String, Integer> entry : map.entrySet()) {
            String key = entry.getKey();
            int value = entry.getValue();

            if (value > bestValue) {
                bestValue = value;
                bestKey = key;
            } 
            else if (value == bestValue &&
                    key.compareTo(bestKey) < 0) {
                bestKey = key;
            }
        }

        System.out.println(bestKey + " " + bestValue);
    }
}

------Tách file lớn thành các chunk theo kích thước byte

import java.io.*;
import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int chunkSize = sc.nextInt();
        int N = sc.nextInt();

        try {
            // Ghi dữ liệu vào big.bin
            FileOutputStream fos = new FileOutputStream("big.bin");

            for (int i = 0; i < N; i++) {
                int x = sc.nextInt();
                fos.write(x);
            }

            fos.close();

            // Tách file thành các chunk
            FileInputStream fis = new FileInputStream("big.bin");

            byte[] buffer = new byte[chunkSize];

            int bytesRead;
            int chunkCount = 0;

            while ((bytesRead = fis.read(buffer)) > 0) {
                chunkCount++;

                FileOutputStream chunkOut =
                        new FileOutputStream(
                                "chunk_" + chunkCount + ".bin");

                chunkOut.write(buffer, 0, bytesRead);

                chunkOut.close();
            }

            fis.close();

            // Đọc lại các chunk
            int totalBytes = 0;
            long sum = 0;

            for (int i = 1; i <= chunkCount; i++) {

                FileInputStream chunkIn =
                        new FileInputStream(
                                "chunk_" + i + ".bin");

                int value;

                while ((value = chunkIn.read()) != -1) {
                    totalBytes++;
                    sum += value;
                }

                chunkIn.close();
            }

            System.out.println("chunks: " + chunkCount);
            System.out.println("bytes: " + totalBytes);
            System.out.println("sum: " + sum);

        } catch (IOException e) {
            e.printStackTrace();
        }
    }
}

-----Tính phương sai của mảng bằng đa luồng công thức

import java.util.*;
import java.util.Locale;

class VarThread extends Thread {
    private int[] arr;
    private int start;
    private int end;

    public long localSum = 0;
    public long localSumSq = 0;

    public VarThread(int[] arr, int start, int end) {
        this.arr = arr;
        this.start = start;
        this.end = end;
    }

    @Override
    public void run() {
        for (int i = start; i < end; i++) {
            localSum += arr[i];
            localSumSq += 1L * arr[i] * arr[i];
        }
    }
}

public class Main {
    public static void main(String[] args) throws Exception {
        Locale.setDefault(Locale.US);

        Scanner sc = new Scanner(System.in);

        int N = sc.nextInt();

        int[] arr = new int[N];

        for (int i = 0; i < N; i++) {
            arr[i] = sc.nextInt();
        }

        int K = sc.nextInt();

        VarThread[] threads = new VarThread[K];

        int size = N / K;
        int start = 0;

        for (int i = 0; i < K; i++) {
            int end;

            if (i == K - 1) {
                end = N;
            } else {
                end = start + size;
            }

            threads[i] = new VarThread(arr, start, end);
            threads[i].start();

            start = end;
        }

        long totalSum = 0;
        long totalSumSq = 0;

        for (int i = 0; i < K; i++) {
            threads[i].join();

            totalSum += threads[i].localSum;
            totalSumSq += threads[i].localSumSq;
        }

        double variance =
                (double) totalSumSq / N
                - Math.pow((double) totalSum / N, 2);

        System.out.printf("%.4f", variance);
    }
}

